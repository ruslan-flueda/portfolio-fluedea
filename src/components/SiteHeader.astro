<header class="site-header" aria-label="Site information">
  <div class="site-header__identity">
    <a class="site-header__name" href="#top" aria-label="Back to top">Ruslan Khairullin</a>
    <span class="site-header__place">
      <span>Saint-Petersburg</span>
      <span class="site-header__dot" aria-hidden="true"></span>
      <time data-petersburg-time>17:30</time>
    </span>
  </div>

  <nav class="site-header__links" aria-label="Social links">
    <a href="https://t.me/flueda" target="_blank" rel="noreferrer">tg</a>
    <a href="https://www.instagram.com/flueda1/" target="_blank" rel="noreferrer">inst</a>
    <a href="mailto:ruslan4ik.hairullin@gmail.com">gmail</a>
  </nav>
</header>

<script>
  const timeNode = document.querySelector<HTMLElement>('[data-petersburg-time]');
  const formatter = new Intl.DateTimeFormat('en-GB', {
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZone: 'Europe/Moscow',
  });

  const updateTime = () => {
    if (!timeNode) return;
    const now = new Date();
    timeNode.textContent = formatter.format(now);
    timeNode.setAttribute('datetime', now.toISOString());
    timeNode.setAttribute('aria-label', `Current Saint Petersburg time: ${formatter.format(now)}`);
  };

  updateTime();
  window.setInterval(updateTime, 30_000);

  const motionLinks = document.querySelectorAll<HTMLAnchorElement>('.site-header__links a');

  for (const link of motionLinks) {
    const showMarker = () => {
      link.classList.remove('is-leaving');
      link.classList.add('is-hovered');
    };

    const hideMarker = () => {
      link.classList.remove('is-hovered');
      link.classList.add('is-leaving');
    };

    link.addEventListener('pointerenter', showMarker);
    link.addEventListener('pointerleave', hideMarker);
    link.addEventListener('focus', showMarker);
    link.addEventListener('blur', hideMarker);
    link.addEventListener('transitionend', (event) => {
      if (
        event.pseudoElement === '::before' &&
        event.propertyName === 'left' &&
        link.classList.contains('is-leaving')
      ) {
        link.classList.remove('is-leaving');
      }
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 100;
    top: clamp(24px, 2.5vw, 48px);
    right: clamp(16px, 1.389vw, 28px);
    left: clamp(16px, 1.389vw, 28px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--chrome);
    font-size: clamp(12px, 0.972vw, 17px);
    line-height: 1.2;
    letter-spacing: -0.04em;
    mix-blend-mode: difference;
    pointer-events: none;
  }

  .site-header__identity,
  .site-header__place,
  .site-header__links {
    display: flex;
    align-items: center;
  }

  .site-header__identity {
    gap: clamp(12px, 0.903vw, 20px);
  }

  .site-header__place {
    gap: clamp(6px, 0.417vw, 10px);
  }

  .site-header__dot {
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: currentColor;
  }

  .site-header__links {
    gap: clamp(10px, 0.833vw, 18px);
  }

  .site-header__links a {
    position: relative;
    display: inline-grid;
    overflow: hidden;
    height: 17px;
    align-items: center;
  }

  .site-header__links a::before {
    position: absolute;
    top: 50%;
    left: -100%;
    width: 100%;
    height: 17px;
    content: '';
    pointer-events: none;
    mix-blend-mode: difference;
    opacity: 0;
    translate: 0 -50%;
    transition:
      left 240ms cubic-bezier(0, 1, 0.57, 0.97),
      opacity 100ms linear;
    will-change: left, opacity;
  }
  
.site-header__links a:nth-child(1)::before {
  background: #529dff; /* tg */
}

.site-header__links a:nth-child(2)::before {
  background: #FF157A; /* inst */
}

.site-header__links a:nth-child(3)::before {
  background: #272727; /* gmail */
}

  .site-header__links a.is-hovered::before {
    left: 0;
    opacity: 1;
  }

  .site-header__links a.is-leaving::before {
    left: 100%;
    opacity: 0;
    transition:
      left 240ms cubic-bezier(0, 1, 0.57, 0.97),
      opacity 80ms linear 160ms;
  }

  .site-header a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.08em;
    pointer-events: auto;
    transition: opacity 180ms ease;
  }

  .site-header__name:hover,
  .site-header__name:focus-visible {
    opacity: 0.62;
  }

  .site-header__links a:hover,
  .site-header__links a:focus-visible {
    color: #fff;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__links a::before {
      display: none;
      transition: none;
    }

    .site-header a {
      transition: none;
    }
  }
</style>
