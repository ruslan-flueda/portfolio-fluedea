---
import { getCollection } from 'astro:content';
import ProgressRibbon from '@/components/ProgressRibbon.astro';

const projects = (await getCollection('projects', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section class="project-grid" aria-label="Selected projects">
  {
    projects.map(({ data, id }) => {
      const label = `${data.title} — ${data.description}. ${data.status === 'ready' ? 'Ready project' : 'In process'}.`;
      const CardElement = data.href ? 'a' : 'button';
      const hasViewCursor = id === 'azimut';

      return (
        <CardElement
          class:list={['project-card', `project-card--${data.size}`]}
          href={data.href}
          type={data.href ? undefined : 'button'}
          aria-label={data.href ? label : `${label} Case study coming soon.`}
          data-status={data.status}
          data-view-cursor={hasViewCursor ? 'true' : undefined}
        >
          <div class:list={['project-card__media', data.ribbon && `project-card__media--${data.ribbon}`]}>
            <img
              class="project-card__cover"
              src={data.cover.src}
              alt=""
              width={data.cover.width}
              height={data.cover.height}
              loading="lazy"
            />
            {data.ribbon && <ProgressRibbon variant={data.ribbon} />}
          </div>
          <div class="project-card__caption">
            <span class="project-card__title">{data.title}</span>
            <span class="project-card__description">{data.description}</span>
          </div>
          {hasViewCursor && <span class="project-card__view" aria-hidden="true">view</span>}
        </CardElement>
      );
    })
  }
</section>

<script>
  const viewCards = document.querySelectorAll<HTMLElement>('[data-view-cursor]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (!prefersReducedMotion.matches) {
    for (const card of viewCards) {
      let bounds: DOMRect | undefined;

      const setCursorPosition = (event: PointerEvent) => {
        bounds ??= card.getBoundingClientRect();
        card.style.setProperty('--view-x', `${event.clientX - bounds.left}px`);
        card.style.setProperty('--view-y', `${event.clientY - bounds.top}px`);
      };

      card.addEventListener('pointerenter', (event) => {
        bounds = card.getBoundingClientRect();
        setCursorPosition(event);
      });

      card.addEventListener('pointermove', setCursorPosition);
      card.addEventListener('pointerleave', () => {
        bounds = undefined;
      });
    }
  }
</script>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.528vw;
    row-gap: 1.389vw;
    width: calc(100% - 2.639vw);
    margin: 5.972vw 1.389vw 0;
  }

  .project-card {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    padding: 0;
    border: 0;
    color: inherit;
    background: #1f1f1f;
    cursor: pointer;
    text-align: left;
  }

  .project-card--wide {
    grid-column: 1 / -1;
  }

  .project-card__media {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .project-card--wide .project-card__media {
    aspect-ratio: 1402 / 560;
  }

  .project-card--half .project-card__media {
    aspect-ratio: 690 / 560;
  }

  .project-card__media--split {
    aspect-ratio: 1402 / 700 !important;
    background: #f8fdff;
  }

  .project-card__cover {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-card__caption {
    display: flex;
    height: 27px;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    color: #fff;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 14px;
    line-height: normal;
    letter-spacing: -0.56px;
    white-space: nowrap;
  }

  .project-card__title {
    font-family: 'Ramabhadra Local', Arial, sans-serif;
    font-weight: 400;
  }

  .project-card__description {
    font-family: Arial, Helvetica, sans-serif;
    font-weight: 300;
    opacity: 0.6;
  }

  .project-card__view {
    position: absolute;
    z-index: 2;
    top: var(--view-y, 50%);
    left: var(--view-x, 50%);
    display: grid;
    height: 17px;
    padding: 0 2px;
    color: #fff;
    background: #000;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(12px, 0.972vw, 17px);
    line-height: 1;
    place-items: center;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(-50%, -50%, 0);
    transition:
      top 420ms cubic-bezier(0.16, 1, 0.3, 1),
      left 420ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 160ms ease;
  }

  .project-card[data-view-cursor]:hover .project-card__view {
    opacity: 1;
  }

  .project-card:focus-visible {
    z-index: 1;
    outline: none;
  }

  .project-card:focus-visible::after {
    position: absolute;
    inset: 3px;
    border: 1px solid rgba(255, 255, 255, 0.86);
    content: '';
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__view {
      transition: opacity 120ms linear;
    }
  }
</style>
