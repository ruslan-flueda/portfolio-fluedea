---
import { getCollection } from 'astro:content';
import ProgressRibbon from '@/components/ProgressRibbon.astro';

const projects = (await getCollection('projects', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section class="project-grid" aria-label="Selected projects">
  {
    projects.map(({ data }) => {
      const label = `${data.title} — ${data.description}. ${data.status === 'ready' ? 'Ready project' : 'In process'}.`;
      const CardElement = data.href ? 'a' : 'button';
      const processRibbon = data.status === 'in-process' ? data.ribbon : undefined;
      // The finished-case treatment is intentionally kept ready for future projects.
      // Adding an href and changing status to `ready` swaps the ribbon for `view` automatically.
      const hasViewReveal = data.status === 'ready' && Boolean(data.href);

      return (
        <CardElement
          class:list={['project-card', `project-card--${data.size}`]}
          href={data.href}
          type={data.href ? undefined : 'button'}
          aria-label={data.href ? label : `${label} Case study coming soon.`}
          data-status={data.status}
          data-analytics-project={data.title}
          data-analytics-project-size={data.size}
        >
          <div class:list={['project-card__media', processRibbon && `project-card__media--${processRibbon}`]}>
            <img
              class="project-card__cover"
              src={data.cover.src}
              alt=""
              width={data.cover.width}
              height={data.cover.height}
              loading="lazy"
            />
            {processRibbon && <ProgressRibbon variant={processRibbon} />}
            {
              hasViewReveal && (
                <span class="project-view" aria-hidden="true">
                  <span class="project-view__label">view</span>
                </span>
              )
            }
          </div>
          <div class="project-card__caption">
            <span class="project-card__title">{data.title}</span>
            <span class="project-card__description">{data.description}</span>
          </div>
        </CardElement>
      );
    })
  }
</section>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.528vw;
    row-gap: 1.389vw;
    width: calc(100% - 2.639vw);
    margin: 5.972vw 1.389vw 0;
  }

  .project-card {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    padding: 0;
    border: 0;
    color: inherit;
    background: #1f1f1f;
    cursor: pointer;
    text-align: left;
  }

  .project-card--wide {
    grid-column: 1 / -1;
  }

  .project-card__media {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .project-card--wide .project-card__media {
    aspect-ratio: 1402 / 560;
  }

  .project-card--half .project-card__media {
    aspect-ratio: 690 / 560;
  }

  .project-card__media--split {
    aspect-ratio: 1402 / 700 !important;
    background: #f8fdff;
  }

  .project-card__cover {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-view {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: clamp(14px, 0.972vw, 19px);
    overflow: hidden;
    background: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: width 420ms cubic-bezier(0.84, 0, 0.31, 0.97);
  }

  .project-view__label {
    position: absolute;
    top: 0;
    left: 50%;
    display: flex;
    width: clamp(200px, 16.667vw, 320px);
    height: clamp(14px, 0.972vw, 19px);
    align-items: center;
    justify-content: center;
    color: #fff;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.56px;
    mix-blend-mode: difference;
    text-align: center;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .project-card:is(:hover, :focus-visible) .project-view {
    width: clamp(200px, 16.667vw, 320px);
  }

  .project-card__caption {
    display: flex;
    height: 27px;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    color: #fff;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 14px;
    line-height: normal;
    letter-spacing: -0.56px;
    white-space: nowrap;
  }

  .project-card__title {
    font-family: 'Ramabhadra Local', Arial, sans-serif;
    font-weight: 400;
  }

  .project-card__description {
    font-family: Arial, Helvetica, sans-serif;
    font-weight: 300;
    opacity: 0.6;
  }

  .project-card:focus-visible {
    z-index: 1;
    outline: none;
  }

  .project-card:focus-visible::after {
    position: absolute;
    inset: 3px;
    border: 1px solid rgba(255, 255, 255, 0.86);
    content: '';
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-view {
      transition: none;
    }
  }

</style>
