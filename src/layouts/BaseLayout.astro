---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ruslan Khairullin — Product Designer',
  description = 'Product designer focused on visual craft, interaction and creative direction.',
} = Astro.props;

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const faviconHref = `${baseUrl}favicon.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" sizes="328x328" href={faviconHref} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
