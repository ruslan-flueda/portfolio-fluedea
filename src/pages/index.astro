---
import HeroCollage from '@/components/HeroCollage.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout>
  <div id="top" class="portfolio-page">
    <SiteHeader />

    <div class="portfolio-page__intro">
      <h1>Product designer with a strong focus on visual craft, interaction and creative direction.</h1>
    </div>

    <main>
      <HeroCollage />
      <ProjectGrid />
    </main>

    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .portfolio-page {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: clip;
  }

  .portfolio-page__intro {
    position: relative;
    height: 19.444vw;
  }

  .portfolio-page__intro h1 {
    position: absolute;
    z-index: 40;
    top: clamp(24px, 2.5vw, 48px);
    left: 26.042vw;
    width: 33.333vw;
    margin: 0;
    color: var(--copy);
    font-family: 'Ramabhadra Local', Arial, sans-serif;
    font-size: clamp(18px, 1.667vw, 32px);
    font-weight: 400;
    line-height: 0.84;
    letter-spacing: -0.04em;
    mix-blend-mode: difference;
  }
</style>

